@page
@model IndexModel
@using weddingapporg.Models
@{
    ViewData["Title"] = "Home — The Editorial Wedding";

    // Service type display info — use arrays to avoid named tuple issues in Razor
    var typeLabels = new Dictionary<int, string[]>
    {
        { 2, new[] { "Catering",              "restaurant_menu" } },
        { 3, new[] { "Photography",           "photo_camera"    } },
        { 4, new[] { "Decoration",            "local_florist"   } },
        { 5, new[] { "Music & Entertainment", "music_note"      } },
        { 6, new[] { "Transportation",        "directions_car"  } },
        { 7, new[] { "Other",                 "room_service"    } },
    };

    var grouped = Model.AdditionalServices
        .GroupBy(s => s.ServiceType)
        .ToList();
}

@if (TempData["SuccessMessage"] != null)
{
    <div style="position:fixed;top:80px;left:50%;transform:translateX(-50%);z-index:9999;min-width:320px;background:#d4edda;color:#155724;border:1px solid #c3e6cb;border-radius:8px;padding:15px 20px;box-shadow:0 4px 12px rgba(0,0,0,.15);text-align:center;">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div style="position:fixed;top:80px;left:50%;transform:translateX(-50%);z-index:9999;min-width:320px;background:#f8d7da;color:#721c24;border:1px solid #f5c6cb;border-radius:8px;padding:15px 20px;box-shadow:0 4px 12px rgba(0,0,0,.15);text-align:center;">
        ⚠️ @TempData["ErrorMessage"]
    </div>
}

<!-- ===================== HERO ===================== -->
<section class="relative h-[921px] flex items-center justify-center overflow-hidden px-8">
    <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-on-surface/20 z-10"></div>
        <img class="w-full h-full object-cover" src="~/imgs/unnamed (1).png" alt="Wedding venue" />
    </div>
    <div class="relative z-20 text-center max-w-4xl">
        <p class="font-label text-white text-xs tracking-[0.3em] uppercase mb-6 opacity-90">Curating Unforgettable Moments</p>
        <h1 class="font-headline text-5xl md:text-7xl lg:text-8xl text-white mb-12 tracking-tight">
            Where <span class="serif-italic">Elegance</span><br />Meets Celebration
        </h1>
        <div class="bg-surface-container-lowest/90 backdrop-blur-md p-2 md:p-3 rounded-lg shadow-2xl flex flex-col md:flex-row gap-2 max-w-3xl mx-auto">
            <div class="flex-1 flex items-center px-4 border-r border-outline-variant/20">
                <span class="material-symbols-outlined text-primary mr-3">location_on</span>
                <input id="searchCity" class="w-full bg-transparent border-none focus:ring-0 font-body text-on-surface placeholder:text-on-surface-variant/50"
                       placeholder="Search destinations..." type="text" />
            </div>
            <div class="flex-1 flex items-center px-4 border-r border-outline-variant/20">
                <span class="material-symbols-outlined text-primary mr-3">calendar_month</span>
                <input id="searchDate" class="w-full bg-transparent border-none focus:ring-0 font-body text-on-surface placeholder:text-on-surface-variant/50"
                       placeholder="Wedding Date" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <button id="searchBtn" class="bg-primary text-on-primary px-8 py-4 rounded-lg font-label text-sm tracking-widest uppercase hover:bg-primary-container transition-colors shrink-0">
                Find Venues
            </button>
        </div>
    </div>
</section>

<!-- ===================== FEATURED VENUES ===================== -->
<section class="py-32 px-8 max-w-7xl mx-auto" id="venues">
    <div class="flex flex-col md:flex-row justify-between items-end mb-20 gap-8">
        <div class="max-w-xl">
            <span class="font-label text-primary text-xs tracking-[0.2em] uppercase mb-4 block">Exquisite Selection</span>
            <h2 class="font-headline text-4xl md:text-5xl text-on-surface leading-tight">
                Featured <span class="serif-italic">Wedding Halls</span>
            </h2>
        </div>
        <a class="font-label text-sm tracking-widest uppercase text-on-surface-variant hover:text-primary border-b border-primary/30 pb-1 transition-all"
           href="/AddNewServices/Index">View All Services</a>
    </div>

    @if (!Model.VenueServices.Any())
    {
        <div class="text-center py-24 text-on-surface-variant">
            <span class="material-symbols-outlined text-6xl opacity-30 block mb-4">domain</span>
            <p class="font-headline text-2xl mb-2">No venues listed yet</p>
            <p class="font-body text-sm opacity-60">The admin will add beautiful venues soon. Check back shortly!</p>
        </div>
    }
    else
    {
        var first = Model.VenueServices[0];
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
            <!-- Large feature card -->
            <a asp-page="/ServiceDetail" asp-route-id="@first.Id"
                   class="md:col-span-7 group cursor-pointer block" style="text-decoration:none;color:inherit;">
                <div class="relative overflow-hidden rounded-lg aspect-[4/3] mb-6">
                    @if (!string.IsNullOrEmpty(first.MainImage))
                    {
                        <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                             src="@first.MainImage" alt="@first.Service_Name" />
                    }
                    else
                    {
                        <div class="w-full h-full bg-primary-fixed/40 flex items-center justify-center">
                            <span class="material-symbols-outlined text-primary text-6xl">domain</span>
                        </div>
                    }
                    <div class="absolute top-6 left-6 bg-surface-container-lowest/90 px-4 py-1 text-[10px] font-label tracking-widest uppercase">
                        @first.City
                    </div>
                </div>
                <h3 class="font-headline text-2xl mb-2">@first.Service_Name</h3>
                @if (!string.IsNullOrEmpty(first.Description))
                {
                    <p class="text-on-surface-variant font-body text-sm leading-relaxed mb-4">
                        @(first.Description.Length > 120 ? first.Description.Substring(0, 120) + "…" : first.Description)
                    </p>
                }
                <div class="flex items-center gap-4 text-primary">
                    <span class="font-label text-xs tracking-widest uppercase">Starting at @first.Price.ToString("C")</span>
                    @if (first.Capacity.HasValue)
                    {
                        <span class="font-label text-xs text-on-surface-variant">· Up to @first.Capacity guests</span>
                    }
                </div>
            </a>

            <!-- Side stack -->
            <div class="md:col-span-5 flex flex-col gap-12">
                @foreach (var venue in Model.VenueServices.Skip(1))
                {
                    <a asp-page="/ServiceDetail" asp-route-id="@venue.Id"
                           class="group cursor-pointer block" style="text-decoration:none;color:inherit;">
                        <div class="relative overflow-hidden rounded-lg aspect-video mb-4">
                            @if (!string.IsNullOrEmpty(venue.MainImage))
                            {
                                <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                                     src="@venue.MainImage" alt="@venue.Service_Name" />
                            }
                            else
                            {
                                <div class="w-full h-full bg-primary-fixed/40 flex items-center justify-center">
                                    <span class="material-symbols-outlined text-primary text-4xl">domain</span>
                                </div>
                            }
                        </div>
                        <h3 class="font-headline text-xl mb-1">@venue.Service_Name</h3>
                        <p class="font-label text-xs text-on-surface-variant tracking-widest uppercase">
                            @venue.City · @venue.Price.ToString("C")
                        </p>
                    </a>
                }
            </div>
        </div>
    }
</section>

<!-- ===================== ADDITIONAL SERVICES ===================== -->
<section class="bg-surface-container-low py-32 overflow-hidden" id="services">
    <div class="max-w-7xl mx-auto px-8">
        <div class="text-center mb-20">
            <span class="font-label text-primary text-xs tracking-[0.2em] uppercase mb-4 block">Everything You Need</span>
            <h2 class="font-headline text-4xl md:text-5xl text-on-surface leading-tight mb-4">
                Premium <span class="serif-italic">Wedding Services</span>
            </h2>
            <p class="font-body text-on-surface-variant max-w-xl mx-auto">
                From fine dining to floral artistry — every detail curated to perfection.
            </p>
        </div>

        @if (!Model.AdditionalServices.Any())
        {
            <div class="text-center py-16 text-on-surface-variant">
                <span class="material-symbols-outlined text-6xl opacity-30 block mb-4">room_service</span>
                <p class="font-headline text-2xl mb-2">No additional services yet</p>
                <p class="font-body text-sm opacity-60">More curated services coming soon.</p>
            </div>
        }
        else
        {
            int rowIndex = 0;
            foreach (var grp in grouped)
            {
                var info = typeLabels.ContainsKey(grp.Key) ? typeLabels[grp.Key] : new[] { "Service", "room_service" };
                var label = info[0];
                var icon = info[1];
                var sample = grp.First();
                var sampleImg = sample.MainImage;
                var sampleDesc = sample.Description ?? "";
                bool isLeft = (rowIndex % 2 == 0);
                rowIndex++;

                if (isLeft)
                {
                    <!-- Left-image layout -->
                    <div class="flex flex-col lg:flex-row items-center gap-20 mb-40">
                        <div class="w-full lg:w-1/2 relative">
                            <div class="absolute -top-10 -left-10 w-40 h-40 bg-primary/5 rounded-full blur-3xl"></div>
                            @if (!string.IsNullOrEmpty(sampleImg))
                            {
                                <img class="relative z-10 w-full rounded-lg shadow-xl" src="@sampleImg" alt="@label" />
                            }
                            else
                            {
                                <div class="relative z-10 w-full h-80 bg-primary-fixed/30 rounded-lg shadow-xl flex items-center justify-center">
                                    <span class="material-symbols-outlined text-primary" style="font-size:5rem;">@icon</span>
                                </div>
                            }
                        </div>
                        <div class="w-full lg:w-1/2">
                            <span class="font-label text-primary text-xs tracking-[0.2em] uppercase mb-4 block">@label</span>
                            <h2 class="font-headline text-4xl md:text-5xl text-on-surface mb-8 leading-tight">
                                <span class="serif-italic">@label</span> Services
                            </h2>
                            @if (!string.IsNullOrEmpty(sampleDesc))
                            {
                                <p class="font-body text-on-surface-variant text-lg leading-relaxed mb-6 max-w-md">
                                    @(sampleDesc.Length > 160 ? sampleDesc.Substring(0, 160) + "…" : sampleDesc)
                                </p>
                            }
                            <div class="space-y-4 mb-8">
                                @foreach (var svc in grp.Take(3))
                                {
                                    <div class="flex items-start gap-4">
                                        <span class="material-symbols-outlined text-primary-container">@icon</span>
                                        <div>
                                            <h4 class="font-headline text-lg mb-0.5">@svc.Service_Name</h4>
                                            <p class="text-sm text-on-surface-variant">@svc.City · @svc.Price.ToString("C") / hr</p>
                                        </div>
                                    </div>
                                }
                            </div>
                            <a asp-page="/ServiceDetail" asp-route-id="@sample.Id"
                                   class="inline-block font-label text-sm tracking-widest uppercase py-4 px-10 border border-outline-variant text-on-surface hover:bg-on-surface hover:text-surface transition-all">
                                Book This Service
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Right-image layout -->
                    <div class="flex flex-col lg:flex-row-reverse items-center gap-20 mb-40">
                        <div class="w-full lg:w-1/2 relative">
                            @if (!string.IsNullOrEmpty(sampleImg))
                            {
                                <img class="relative z-10 w-full rounded-lg shadow-xl" src="@sampleImg" alt="@label" />
                            }
                            else
                            {
                                <div class="relative z-10 w-full h-80 bg-primary-fixed/30 rounded-lg shadow-xl flex items-center justify-center">
                                    <span class="material-symbols-outlined text-primary" style="font-size:5rem;">@icon</span>
                                </div>
                            }
                        </div>
                        <div class="w-full lg:w-1/2">
                            <span class="font-label text-primary text-xs tracking-[0.2em] uppercase mb-4 block">@label</span>
                            <h2 class="font-headline text-4xl md:text-5xl text-on-surface mb-8 leading-tight">
                                <span class="serif-italic">@label</span> Services
                            </h2>
                            @if (!string.IsNullOrEmpty(sampleDesc))
                            {
                                <p class="font-body text-on-surface-variant text-lg leading-relaxed mb-6 max-w-md">
                                    @(sampleDesc.Length > 160 ? sampleDesc.Substring(0, 160) + "…" : sampleDesc)
                                </p>
                            }
                            <div class="space-y-4 mb-8">
                                @foreach (var svc in grp.Take(3))
                                {
                                    <div class="flex items-start gap-4">
                                        <span class="material-symbols-outlined text-primary-container">@icon</span>
                                        <div>
                                            <h4 class="font-headline text-lg mb-0.5">@svc.Service_Name</h4>
                                            <p class="text-sm text-on-surface-variant">@svc.City · @svc.Price.ToString("C") / hr</p>
                                        </div>
                                    </div>
                                }
                            </div>
                            <a asp-page="/ServiceDetail" asp-route-id="@sample.Id"
                                   class="inline-block font-label text-sm tracking-widest uppercase py-4 px-10 border border-outline-variant text-on-surface hover:bg-on-surface hover:text-surface transition-all">
                                Book This Service
                            </a>
                        </div>
                    </div>
                }
            }
        }
    </div>
</section>

<!-- ===================== STATS ===================== -->
<section class="py-24 px-8">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-12 text-center">
        <div>
            <div class="font-headline text-4xl text-primary mb-2">@(Model.VenueServices.Any() ? Model.VenueServices.Count + "+" : "—")</div>
            <div class="font-label text-[10px] tracking-[0.2em] uppercase text-on-surface-variant">Venues Listed</div>
        </div>
        <div>
            <div class="font-headline text-4xl text-primary mb-2">@(Model.AdditionalServices.Any() ? Model.AdditionalServices.Count + "+" : "—")</div>
            <div class="font-label text-[10px] tracking-[0.2em] uppercase text-on-surface-variant">Services Available</div>
        </div>
        <div>
            <div class="font-headline text-4xl text-primary mb-2">24/7</div>
            <div class="font-label text-[10px] tracking-[0.2em] uppercase text-on-surface-variant">Concierge Support</div>
        </div>
        <div>
            <div class="font-headline text-4xl text-primary mb-2">100%</div>
            <div class="font-label text-[10px] tracking-[0.2em] uppercase text-on-surface-variant">Verified Providers</div>
        </div>
    </div>
</section>

@section Scripts {
    <button id="chatToggleBtn" class="fixed bottom-6 right-6 bg-[#b2905a] text-white p-4 rounded-full shadow-2xl hover:bg-[#9a7b4c] transition-all duration-300 z-50 flex items-center justify-center group">
        <svg id="chatIcon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 transition-transform duration-300 group-hover:scale-110">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.501 48.172 48.172 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
        </svg>
        <svg id="closeIcon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 hidden transition-transform duration-300 group-hover:scale-110">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
    </button>

    <div id="chatWindow" class="fixed bottom-24 right-6 w-96 h-[540px] bg-white rounded-2xl shadow-2xl z-50 flex flex-col overflow-hidden border border-gray-100 hidden opacity-0 translate-y-4 transition-all duration-300">
        <!-- Header -->
        <div class="bg-[#b2905a] p-4 text-white flex items-center justify-between shadow-md">
            <div class="flex items-center space-x-3">
                <div class="w-2.5 h-2.5 bg-green-400 rounded-full animate-pulse"></div>
                <div>
                    <span class="font-semibold tracking-wide block leading-tight">WeddingAI Concierge</span>
                    <span class="text-[11px] opacity-90 block">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <text>👤 Logged in as: <strong>@(User.Identity?.Name ?? "User")</strong></text>
                        }
                        else
                        {
                            <text>👤 Guest mode · <a href="/Identity/Account/Login" class="underline hover:text-amber-100">Sign in to book</a></text>
                        }
                    </span>
                </div>
            </div>
        </div>

        <!-- Messages Area -->
        <div id="chatMessages" class="flex-1 p-4 overflow-y-auto space-y-4 bg-gray-50 text-sm">
            <div class="flex items-start space-x-2">
                <div class="bg-[#b2905a] text-white p-3.5 rounded-2xl rounded-tl-none max-w-[85%] shadow-sm leading-relaxed">
                    مرحباً بك في WeddingAI! 🌸<br />
                    أنا مساعدك الذكي لحجوزات الأعراس. يمكنك الاستفسار عن الأماكن والخدمات المتاحة والمواعيد الشاغرة، أو طلب الحجز مباشرة هنا!
                </div>
            </div>
        </div>

        <!-- Quick suggestion chips -->
        <div class="px-3 py-1.5 bg-gray-100 flex items-center gap-1.5 overflow-x-auto no-scrollbar text-xs">
            <button type="button" onclick="sendQuickPrompt('What wedding venues are available?')" class="whitespace-nowrap px-2.5 py-1 bg-white hover:bg-[#b2905a] hover:text-white rounded-full border border-gray-200 text-gray-700 transition-colors shadow-xs">🏰 Available Venues</button>
            <button type="button" onclick="sendQuickPrompt('What slots are available for Photography tomorrow?')" class="whitespace-nowrap px-2.5 py-1 bg-white hover:bg-[#b2905a] hover:text-white rounded-full border border-gray-200 text-gray-700 transition-colors shadow-xs">📸 Photography Slots</button>
            <button type="button" onclick="sendQuickPrompt('Show me available catering services')" class="whitespace-nowrap px-2.5 py-1 bg-white hover:bg-[#b2905a] hover:text-white rounded-full border border-gray-200 text-gray-700 transition-colors shadow-xs">🍽️ Catering</button>
        </div>

        <!-- Input Area -->
        <div class="p-3 bg-white border-t border-gray-100 flex items-center space-x-2">
            <input type="text" id="chatInput" placeholder="Ask about availability or request a booking..." class="flex-1 border border-gray-200 rounded-full px-4 py-2 text-sm focus:outline-none focus:border-[#b2905a] transition-colors" />
            <button id="sendChatBtn" class="bg-[#b2905a] text-white p-2 rounded-full hover:bg-[#9a7b4c] transition-colors shadow-md">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 transform rotate-90">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
                </svg>
            </button>
        </div>
    </div>

    <script>
        const currentUserId = "@(User.Identity?.IsAuthenticated == true ? (User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "") : "")";
        const currentUserName = "@(User.Identity?.IsAuthenticated == true ? (User.Identity?.Name ?? "User") : "")";
        const currentUserEmail = "@(User.Identity?.IsAuthenticated == true ? (User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "") : "")";

        const chatToggleBtn = document.getElementById('chatToggleBtn');
        const chatWindow = document.getElementById('chatWindow');
        const chatIcon = document.getElementById('chatIcon');
        const closeIcon = document.getElementById('closeIcon');
        const chatInput = document.getElementById('chatInput');
        const sendChatBtn = document.getElementById('sendChatBtn');
        const chatMessages = document.getElementById('chatMessages');

        // Toggle chat modal
        chatToggleBtn.addEventListener('click', () => {
            if (chatWindow.classList.contains('hidden')) {
                chatWindow.classList.remove('hidden');
                setTimeout(() => {
                    chatWindow.classList.remove('opacity-0', 'translate-y-4');
                    chatWindow.classList.add('opacity-100', 'translate-y-0');
                }, 10);
                chatIcon.classList.add('hidden');
                closeIcon.classList.remove('hidden');
            } else {
                chatWindow.classList.remove('opacity-100', 'translate-y-0');
                chatWindow.classList.add('opacity-0', 'translate-y-4');
                chatIcon.classList.remove('hidden');
                closeIcon.classList.add('hidden');
                setTimeout(() => {
                    chatWindow.classList.add('hidden');
                }, 300);
            }
        });

        function sendQuickPrompt(promptText) {
            chatInput.value = promptText;
            sendMessage();
        }

        function formatAiResponse(text) {
            if (!text) return "";
            let formatted = text
                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.*?)\*/g, '<em>$1</em>')
                .replace(/`([^`]+)`/g, '<code class="bg-amber-100 text-amber-900 px-1 rounded text-xs">$1</code>')
                .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-amber-800 underline font-semibold hover:text-amber-900">$1</a>')
                .replace(/\n/g, '<br/>');
            return formatted;
        }

        async function sendMessage() {
            const text = chatInput.value.trim();
            if (!text) return;

            // 1. Render User Message
            const userMsgDiv = document.createElement('div');
            userMsgDiv.className = "flex items-start justify-end space-x-2";
            userMsgDiv.innerHTML = `<div class="bg-gray-200 text-gray-800 p-3 rounded-2xl rounded-tr-none max-w-[85%] shadow-sm">${text}</div>`;
            chatMessages.appendChild(userMsgDiv);
            chatInput.value = '';
            chatMessages.scrollTop = chatMessages.scrollHeight;

            // 2. Typing indicator
            const typingDiv = document.createElement('div');
            typingDiv.className = "flex items-start space-x-2 id-typing";
            typingDiv.innerHTML = `<div class="bg-[#b2905a] text-white p-3 rounded-2xl rounded-tl-none max-w-[85%] shadow-sm italic animate-pulse">جاري البحث والتحقق من التوفر...</div>`;
            chatMessages.appendChild(typingDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;

            try {
                // 3. Request to FastAPI Backend with User Identity
                const response = await fetch('http://localhost:8000/ask-ai', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        messagetxt: text,
                        user_id: currentUserId || null,
                        user_name: currentUserName || null,
                        user_email: currentUserEmail || null
                    })
                });

                const data = await response.json();
                typingDiv.remove();

                // 4. Render AI Response
                const botMsgDiv = document.createElement('div');
                botMsgDiv.className = "flex items-start space-x-2";
                botMsgDiv.innerHTML = `<div class="bg-[#b2905a] text-white p-3.5 rounded-2xl rounded-tl-none max-w-[85%] shadow-sm leading-relaxed">${formatAiResponse(data.ai_response)}</div>`;
                chatMessages.appendChild(botMsgDiv);
            } catch (error) {
                console.error("Error communicating with AI backend:", error);
                typingDiv.remove();
                const errorDiv = document.createElement('div');
                errorDiv.className = "flex items-start space-x-2";
                errorDiv.innerHTML = `<div class="bg-red-100 text-red-700 p-3 rounded-2xl rounded-tl-none max-w-[85%] shadow-sm">⚠️ حدث خطأ أثناء الاتصال بالخادم. يرجى التأكد من تشغيل خادم FastAPI (main.py).</div>`;
                chatMessages.appendChild(errorDiv);
            }
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        sendChatBtn.addEventListener('click', sendMessage);
        chatInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') sendMessage();
        });
    </script>
}