@using weddingapporg.Services
@inject CartService _cartSvc
<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - weddingapporg</title>
    
    <!-- Google Fonts -->
    <link href="~/css/g1font.css" rel="stylesheet" />
    <link href="~/css/g2font.css" rel="stylesheet" />
    
    <!-- Tailwind CSS -->
    <script src="~/js/tailwind.js"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "on-surface-variant": "#4e4639",
                        "primary-fixed": "#ffdea5",
                        "on-primary-fixed": "#261900",
                        "on-secondary-fixed": "#1b1c1c",
                        "on-error-container": "#93000a",
                        "surface-tint": "#775a19",
                        "primary": "#775a19",
                        "secondary-fixed": "#e4e2e1",
                        "tertiary-fixed-dim": "#c9c6c1",
                        "primary-container": "#c5a059",
                        "surface-container-low": "#f4f3f2",
                        "surface-dim": "#dadad9",
                        "tertiary-fixed": "#e5e2dc",
                        "error-container": "#ffdad6",
                        "surface-bright": "#faf9f8",
                        "on-error": "#ffffff",
                        "secondary-container": "#e4e2e1",
                        "primary-fixed-dim": "#e9c176",
                        "on-primary-fixed-variant": "#5d4201",
                        "on-secondary": "#ffffff",
                        "tertiary-container": "#a7a5a0",
                        "surface-container-high": "#e9e8e7",
                        "on-primary-container": "#4e3700",
                        "on-tertiary-container": "#3b3b37",
                        "on-secondary-container": "#656464",
                        "inverse-primary": "#e9c176",
                        "tertiary": "#5f5e5a",
                        "error": "#ba1a1a",
                        "on-surface": "#1a1c1c",
                        "surface-container": "#eeeeed",
                        "outline": "#7f7667",
                        "secondary": "#5f5e5e",
                        "on-tertiary-fixed": "#1c1c18",
                        "on-tertiary": "#ffffff",
                        "on-primary": "#ffffff",
                        "background": "#faf9f8",
                        "on-secondary-fixed-variant": "#474747",
                        "surface": "#faf9f8",
                        "surface-container-lowest": "#ffffff",
                        "inverse-surface": "#2f3130",
                        "inverse-on-surface": "#f1f0f0",
                        "on-background": "#1a1c1c",
                        "outline-variant": "#d1c5b4",
                        "on-tertiary-fixed-variant": "#474743",
                        "surface-container-highest": "#e3e2e1",
                        "secondary-fixed-dim": "#c8c6c5",
                        "surface-variant": "#e3e2e1"
                    },
                    fontFamily: {
                        "headline": ["Noto Serif"],
                        "body": ["Manrope"],
                        "label": ["Manrope"]
                    },
                    borderRadius: {"DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem"},
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
        }
        .serif-italic { font-family: 'Noto Serif'; font-style: italic; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
    </style>
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-surface text-on-surface font-body selection:bg-primary-fixed selection:text-on-primary-fixed">

    <!-- ========== HEADER من كود HTML ========== -->
    <nav class="fixed top-0 w-full z-50 bg-[#faf9f8] dark:bg-stone-950/80 backdrop-blur-xl shadow-[0_20px_40px_rgba(26,28,28,0.04)]">
        <div class="flex justify-between items-center px-8 py-6 max-w-full mx-auto font-['Noto_Serif'] antialiased tracking-tight">
            <div class="text-2xl font-serif italic text-[#1a1c1c] dark:text-[#faf9f8]">
                The Editorial Wedding
            </div>
            <div class="hidden md:flex items-center space-x-12">
                <a class="text-[#1a1c1c]/70 dark:text-[#faf9f8]/70 hover:text-[#775a19] transition-colors" href="/AddNewServices/Index">Services</a>
                <a class="text-[#1a1c1c]/70 dark:text-[#faf9f8]/70 hover:text-[#775a19] transition-colors" asp-page="/MyBookings">My Bookings</a>
            </div>
            <div class="flex items-center space-x-6">
                @{
                    int cartCount = 0;
                    try { cartCount = _cartSvc.Count(Context.Session); } catch { }
                }
                <!-- Cart icon -->
                <a asp-page="/Cart" class="relative text-[#1a1c1c]/70 hover:text-[#775a19] transition-colors">
                    <span class="material-symbols-outlined text-2xl">shopping_cart</span>
                    @if (cartCount > 0)
                    {
                        <span class="absolute -top-1.5 -right-1.5 bg-primary text-on-primary text-[10px] font-bold w-4.5 h-4.5 rounded-full flex items-center justify-center" style="min-width:18px;height:18px;font-size:10px;padding:2px;">@cartCount</span>
                    }
                </a>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>

    <!-- ========== MAIN CONTENT ========== -->
    <main class="pt-24">
        @RenderBody()
    </main>

    <!-- ========== FOOTER من كود HTML ========== -->
    <footer class="bg-[#f4f3f2] dark:bg-stone-900 w-full border-t border-stone-200/50 dark:border-stone-800/50">
        <div class="flex flex-col md:flex-row justify-between items-center px-12 py-16 w-full font-['Manrope'] text-sm tracking-widest uppercase">
            <div class="mb-8 md:mb-0">
                <div class="text-lg font-serif text-[#1a1c1c] dark:text-[#faf9f8] lowercase italic mb-2">the editorial wedding</div>
                <p class="text-[10px] opacity-60 normal-case tracking-normal font-light">© 2024 The Editorial Wedding Experience. All rights reserved.</p>
            </div>
            <div class="flex flex-wrap justify-center gap-8">
                <a class="text-[#1a1c1c]/60 dark:text-[#faf9f8]/60 hover:text-[#775a19] dark:hover:text-[#c5a059] transition-colors" asp-page="/Contact">Contact Us</a>
                <a class="text-[#1a1c1c]/60 dark:text-[#faf9f8]/60 hover:text-[#775a19] dark:hover:text-[#c5a059] transition-colors" asp-page="/Privacy">Privacy Policy</a>
                <a class="text-[#1a1c1c]/60 dark:text-[#faf9f8]/60 hover:text-[#775a19] dark:hover:text-[#c5a059] transition-colors" asp-page="/Terms">Terms of Service</a>
                <a class="text-[#1a1c1c]/60 dark:text-[#faf9f8]/60 hover:text-[#775a19] dark:hover:text-[#c5a059] transition-colors" href="#">Instagram</a>
                <a class="text-[#1a1c1c]/60 dark:text-[#faf9f8]/60 hover:text-[#775a19] dark:hover:text-[#c5a059] transition-colors" href="#">Pinterest</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>