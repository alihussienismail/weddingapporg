@page
@{
    Layout = "/Pages/Shared/AdminLTE/_Layout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <div class="alert alert-info">
        <h2>Welcome, Admin!</h2>
        <p>This is the admin panel. You can manage users, services, and more from here.</p>
    </div>
    
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">Users Management</div>
                <div class="card-body">
                    <a asp-page="/Admin/Users" class="btn btn-primary">Manage Users</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">Services Management</div>
                <div class="card-body">
                    <a asp-page="/Admin/Services" class="btn btn-primary">Manage Services</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">Reports</div>
                <div class="card-body">
                    <a asp-page="/Admin/Reports" class="btn btn-primary">View Reports</a>
                </div>
            </div>
        </div>
    </div>
</div>