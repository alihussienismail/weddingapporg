@page
@model weddingapporg.Pages.Admin.ServicesModel
@{
    Layout = "/Pages/Shared/AdminLTE/_Layout.cshtml";
    ViewData["Title"] = "Manage Services";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">All Services</h3>
        <a asp-page="/AddService" class="btn btn-primary float-right">Add New Service</a>
    </div>
    <div class="card-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Price</th>
                    <th>City</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var service in Model.Services)
                {
                    <tr>
                        <td>@service.Service_Name</td>
                        <td>@service.ServiceType</td>
                        <td>$@service.Price</td>
                        <td>@service.City</td>
                        <td>
                            <a asp-page="/ServiceDetails" asp-route-id="@service.Id" class="btn btn-sm btn-info">View</a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@service.Id" style="display:inline">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
