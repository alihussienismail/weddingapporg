@page
@model CartModel
@using weddingapporg.Models
@{
    ViewData["Title"] = "My Cart";
    var typeNames = new Dictionary<int, string[]>
    {
        { 1, new[] { "Venue",                 "domain"         } },
        { 2, new[] { "Catering",              "restaurant_menu"} },
        { 3, new[] { "Photography",           "photo_camera"   } },
        { 4, new[] { "Decoration",            "local_florist"  } },
        { 5, new[] { "Music & Entertainment", "music_note"     } },
        { 6, new[] { "Transportation",        "directions_car" } },
        { 7, new[] { "Other",                 "room_service"   } },
    };
}

<div class="max-w-5xl mx-auto px-6 py-12">

    <!-- Header -->
    <div class="flex items-center justify-between mb-10">
        <div>
            <h1 class="font-headline text-3xl md:text-4xl text-on-surface">
                Your Wedding Cart
            </h1>
            <p class="font-body text-sm text-on-surface-variant mt-1">
                @Model.Items.Count item@(Model.Items.Count != 1 ? "s" : "") selected
            </p>
        </div>
        <a asp-page="/Index" class="font-label text-xs uppercase tracking-widest text-primary border-b border-primary/30 pb-1 hover:opacity-70 transition-all">
            ← Continue Browsing
        </a>
    </div>

    @if (TempData["CartError"] != null)
    {
        <div class="bg-error-container text-on-error-container rounded-xl p-4 mb-6 text-sm">
            ⚠ @TempData["CartError"]
        </div>
    }

    @if (!Model.Items.Any())
    {
        <!-- Empty cart -->
        <div class="text-center py-32 text-on-surface-variant">
            <span class="material-symbols-outlined text-7xl opacity-25 block mb-6">shopping_cart</span>
            <h2 class="font-headline text-2xl mb-2">Your cart is empty</h2>
            <p class="font-body text-sm opacity-60 mb-8">Browse venues and services to build your perfect wedding day.</p>
            <a asp-page="/Index" class="bg-primary text-on-primary px-8 py-4 rounded-xl font-label text-sm tracking-widest uppercase hover:bg-[#5d4201] transition-colors">
                Explore Venues
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

            <!-- Cart Items -->
            <div class="lg:col-span-2 space-y-4">
                @foreach (var item in Model.Items)
                {
                    var info = typeNames.ContainsKey(item.ServiceType) ? typeNames[item.ServiceType] : new[] { "Service", "room_service" };
                    <div class="bg-surface-container-lowest border border-outline-variant/30 rounded-2xl overflow-hidden flex gap-0 shadow-sm hover:shadow-md transition-all">

                        <!-- Thumbnail -->
                        <div class="w-28 md:w-36 shrink-0 bg-primary-fixed/20 overflow-hidden">
                            @if (!string.IsNullOrEmpty(item.MainImage))
                            {
                                <img src="@item.MainImage" alt="@item.ServiceName" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center">
                                    <span class="material-symbols-outlined text-primary text-3xl">@info[1]</span>
                                </div>
                            }
                        </div>

                        <!-- Details -->
                        <div class="flex-1 p-4 md:p-5 flex flex-col justify-between min-w-0">
                            <div>
                                <span class="font-label text-[10px] uppercase tracking-widest text-primary block mb-0.5">@info[0]</span>
                                <h3 class="font-headline text-lg text-on-surface truncate">@item.ServiceName</h3>
                                <p class="text-xs text-on-surface-variant">@item.City</p>

                                <div class="flex flex-wrap gap-3 mt-2">
                                    <span class="flex items-center gap-1 text-xs text-on-surface-variant">
                                        <span class="material-symbols-outlined text-sm text-primary">calendar_month</span>
                                        @item.BookingDate.ToString("EEE, MMM d yyyy")
                                    </span>
                                    @if (item.IsVenue)
                                    {
                                        <span class="flex items-center gap-1 text-xs text-on-surface-variant">
                                            <span class="material-symbols-outlined text-sm text-primary">event</span>
                                            Full Day
                                        </span>
                                    }
                                    else if (item.StartHour.HasValue)
                                    {
                                        <span class="flex items-center gap-1 text-xs text-on-surface-variant">
                                            <span class="material-symbols-outlined text-sm text-primary">schedule</span>
                                            @item.StartHour:00 – @item.EndHour:00
                                            (@(item.EndHour - item.StartHour) hr)
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="flex items-center justify-between mt-3">
                                <span class="font-headline text-xl text-primary">@item.TotalPrice.ToString("C")</span>
                                <!-- Remove -->
                                <form method="post" asp-page-handler="Remove">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="RemoveCartItemId" value="@item.CartItemId" />
                                    <button type="submit"
                                            class="flex items-center gap-1 text-xs text-on-surface-variant hover:text-error transition-colors font-label">
                                        <span class="material-symbols-outlined text-sm">delete</span> Remove
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }

                <!-- Add more services link -->
                <div class="border-2 border-dashed border-outline-variant/40 rounded-2xl p-6 text-center">
                    <span class="material-symbols-outlined text-primary text-3xl block mb-2">add_circle</span>
                    <p class="text-sm text-on-surface-variant mb-3">Want to add more services?</p>
                    <a asp-page="/Index" class="font-label text-xs uppercase tracking-widest text-primary border-b border-primary/30 pb-0.5">
                        Browse Services
                    </a>
                </div>
            </div>

            <!-- Order Summary & Checkout -->
            <div class="lg:col-span-1">
                <div class="sticky top-28 bg-surface-container-lowest border border-outline-variant/30 rounded-2xl shadow-xl overflow-hidden">
                    <div class="bg-primary px-6 py-4">
                        <h2 class="font-headline text-lg text-on-primary">Order Summary</h2>
                    </div>
                    <div class="p-6">
                        <!-- Line items -->
                        <div class="space-y-2.5 mb-5">
                            @foreach (var item in Model.Items)
                            {
                                <div class="flex justify-between text-sm">
                                    <span class="text-on-surface-variant truncate max-w-[180px]">@item.ServiceName</span>
                                    <span class="font-semibold text-on-surface shrink-0 ml-2">@item.TotalPrice.ToString("C")</span>
                                </div>
                            }
                        </div>
                        <div class="border-t border-outline-variant pt-4 mb-6">
                            <div class="flex justify-between items-center">
                                <span class="font-label text-xs uppercase tracking-widest text-on-surface-variant">Total</span>
                                <span class="font-headline text-2xl text-primary">@Model.GrandTotal.ToString("C")</span>
                            </div>
                        </div>

                        <!-- Checkout -->
                        <form method="post" asp-page-handler="Checkout">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="w-full bg-primary text-on-primary py-4 rounded-xl font-label text-sm tracking-widest uppercase hover:bg-[#5d4201] transition-colors shadow-md flex items-center justify-center gap-2">
                                <span class="material-symbols-outlined text-base">payment</span>
                                Pay Now
                            </button>
                        </form>

                        <div class="flex items-center justify-center gap-1.5 mt-3 opacity-50">
                            <span class="material-symbols-outlined text-sm">lock</span>
                            <span class="text-xs text-on-surface-variant">Secured by Stripe</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
