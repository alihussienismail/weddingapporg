@model weddingapporg.Models.Service
@{
    ViewData["Title"] = "Add New Service";
}

<div class="max-w-3xl mx-auto px-6 py-10">

    <!-- Header -->
    <div class="mb-8">
        <a asp-action="Index" class="inline-flex items-center gap-1 text-sm text-[#775a19] hover:underline mb-4">
            <span class="material-symbols-outlined text-base">arrow_back</span> Back to Services
        </a>
        <h1 class="text-3xl font-headline font-bold text-[#1a1c1c] tracking-tight">Add New Service</h1>
        <p class="text-sm text-[#4e4639] mt-1 opacity-70">Fill in the details below to list a new wedding service</p>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-[#e3e2e1] p-8">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            
            <div asp-validation-summary="ModelOnly" class="mb-6 p-4 bg-red-50 border border-red-200 text-red-700 rounded-xl text-sm"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <!-- Service Name -->
                <div class="md:col-span-2">
                    <label asp-for="Service_Name" class="block text-xs font-semibold text-[#4e4639] uppercase tracking-widest mb-2">Service Name</label>
                    <input asp-for="Service_Name" class="w-full border border-[#d1c5b4] rounded-xl px-4 py-3 text-sm text-[#1a1c1c] focus:outline-none focus:ring-2 focus:ring-[#775a19]/40 focus:border-[#775a19] transition-all" placeholder="e.g. Royal Ballroom Package" />
                    <span asp-validation-for="Service_Name" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Service Type -->
                <div>
                    <label asp-for="ServiceType" class="block text-xs font-semibold text-[#4e4639] uppercase tracking-widest mb-2">Service Type</label>
                    <select asp-for="ServiceType" class="w-full border border-[#d1c5b4] rounded-xl px-4 py-3 text-sm text-[#1a1c1c] focus:outline-none focus:ring-2 focus:ring-[#775a19]/40 focus:border-[#775a19] transition-all">
                        <option value="">-- Select Type --</option>
                        <option value="1">Venue</option>
                        <option value="2">Catering</option>
                        <option value="3">Photography</option>
                        <option value="4">Decoration</option>
                        <option value="5">Music & Entertainment</option>
                        <option value="6">Transportation</option>
                        <option value="7">Other</option>
                    </select>
                    <span asp-validation-for="ServiceType" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Price -->
                <div>
                    <label asp-for="Price" class="block text-xs font-semibold text-[#4e4639] uppercase tracking-widest mb-2">Price</label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[#4e4639]/60 text-sm">$</span>
                        <input asp-for="Price" type="number" step="0.01" min="0"
                               class="w-full border border-[#d1c5b4] rounded-xl pl-7 pr-4 py-3 text-sm text-[#1a1c1c] focus:outline-none focus:ring-2 focus:ring-[#775a19]/40 focus:border-[#775a19] transition-all"
                               placeholder="0.00" />
                    </div>
                    <span asp-validation-for="Price" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- City -->
                <div>
                    <label asp-for="City" class="block text-xs font-semibold text-[#4e4639] uppercase tracking-widest mb-2">City</label>
                    <input asp-for="City" class="w-full border border-[#d1c5b4] rounded-xl px-4 py-3 text-sm text-[#1a1c1c] focus:outline-none focus:ring-2 focus:ring-[#775a19]/40 focus:border-[#775a19] transition-all" placeholder="e.g. New York" />
                    <span asp-validation-for="City" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Capacity -->
                <div>
                    <label asp-for="Capacity" class="block text-xs font-semibold text-[#4e4639] uppercase tracking-widest mb-2">Capacity</label>
                    <input asp-for="Capacity" type="number" min="1"
                           class="w-full border border-[#d1c5b4] rounded-xl px-4 py-3 text-sm text-[#1a1c1c] focus:outline-none focus:ring-2 focus:ring-[#775a19]/40 focus:border-[#775a19] transition-all"
                           placeholder="e.g. 200 guests" />
                    <span asp-validation-for="Capacity" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Address -->
                <div class="md:col-span-2">
                    <label asp-for="Address" class="block text-xs font-semibold text-[#4e4639] uppercase tracking-widest mb-2">Address</label>
                    <input asp-for="Address" class="w-full border border-[#d1c5b4] rounded-xl px-4 py-3 text-sm text-[#1a1c1c] focus:outline-none focus:ring-2 focus:ring-[#775a19]/40 focus:border-[#775a19] transition-all" placeholder="Full address" />
                    <span asp-validation-for="Address" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Main Image -->
                <div>
                    <label class="block text-xs font-semibold text-[#4e4639] uppercase tracking-widest mb-2">Main Image</label>
                    <input type="file" name="imageFile" class="w-full border border-[#d1c5b4] rounded-xl px-4 py-3 text-sm text-[#1a1c1c] file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-[#775a19] file:text-white hover:file:bg-[#5a4312]" accept="image/*" />
                    
                    <!-- معاينة الصورة -->
                    <div id="previewContainer" class="mt-3" style="display: none;">
                        <img id="imagePreview" class="w-32 h-32 object-cover rounded-lg border-2 border-[#775a19]" />
                        <p class="text-xs text-gray-500 mt-1">Image Preview</p>
                    </div>
                </div>

                <!-- Description -->
                <div class="md:col-span-2">
                    <label asp-for="Description" class="block text-xs font-semibold text-[#4e4639] uppercase tracking-widest mb-2">Description</label>
                    <textarea asp-for="Description" rows="4"
                              class="w-full border border-[#d1c5b4] rounded-xl px-4 py-3 text-sm text-[#1a1c1c] focus:outline-none focus:ring-2 focus:ring-[#775a19]/40 focus:border-[#775a19] transition-all resize-y"
                              placeholder="Describe the service in detail..."></textarea>
                    <span asp-validation-for="Description" class="text-red-500 text-xs mt-1 block"></span>
                </div>

            </div>

            <!-- Actions -->
            <div class="flex items-center justify-end gap-4 mt-8 pt-6 border-t border-[#e3e2e1]">
                <a asp-action="Index"
                       class="px-6 py-2.5 text-sm font-semibold text-[#4e4639] hover:text-[#1a1c1c] border border-[#d1c5b4] rounded-full transition-all hover:border-[#4e4639]">
                    Cancel
                </a>
                <button type="submit"
                        class="px-6 py-2.5 text-sm font-semibold text-white bg-[#775a19] hover:bg-[#5d4201] rounded-full shadow-md hover:shadow-lg transition-all duration-300">
                    Create Service
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    
    <script>
        // معاينة الصورة عند الاختيار
        document.querySelector('input[type="file"]').addEventListener('change', function(event) {
            const file = event.target.files[0];
            const previewContainer = document.getElementById('previewContainer');
            const previewImage = document.getElementById('imagePreview');
            
            if (file && file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImage.src = e.target.result;
                    previewContainer.style.display = 'block';
                }
                reader.readAsDataURL(file);
            } else {
                previewContainer.style.display = 'none';
                previewImage.src = '';
            }
        });
    </script>
}
