@model weddingapporg.Models.Service
@{
    ViewData["Title"] = "Service Details";
}

<div class="max-w-3xl mx-auto px-6 py-10">

    <!-- Header -->
    <div class="mb-8">
        <a asp-action="Index" class="inline-flex items-center gap-1 text-sm text-[#775a19] hover:underline mb-4">
            <span class="material-symbols-outlined text-base">arrow_back</span> Back to Services
        </a>
        <h1 class="text-3xl font-headline font-bold text-[#1a1c1c] tracking-tight">Service Details</h1>
    </div>

    <!-- Detail Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-[#e3e2e1] overflow-hidden">

        <!-- Image Banner -->
        @if (!string.IsNullOrEmpty(Model.MainImage))
        {
            <img src="@Model.MainImage" alt="@Model.Service_Name"
                 class="w-full h-56 object-cover" />
        }
        else
        {
            <div class="w-full h-32 bg-gradient-to-r from-[#ffdea5]/40 to-[#c5a059]/20 flex items-center justify-center">
                <span class="material-symbols-outlined text-5xl text-[#775a19]/30">photo</span>
            </div>
        }

        <div class="p-8">
            <!-- Title + Badge -->
            <div class="flex items-start justify-between mb-6">
                <div>
                    <h2 class="text-2xl font-headline font-bold text-[#1a1c1c]">@Model.Service_Name</h2>
                    <p class="text-sm text-[#4e4639]/60 mt-1">@Model.City @(!string.IsNullOrEmpty(Model.Address) ? "· " + Model.Address : "")</p>
                </div>
                <span class="inline-block bg-[#ffdea5]/50 text-[#5d4201] text-xs font-semibold px-3 py-1.5 rounded-full whitespace-nowrap">
                    Type @Model.ServiceType
                </span>
            </div>

            <!-- Stat Pills -->
            <div class="flex flex-wrap gap-4 mb-6">
                <div class="flex items-center gap-2 bg-[#f4f3f2] px-4 py-2 rounded-full">
                    <span class="material-symbols-outlined text-[#775a19] text-lg">payments</span>
                    <span class="text-sm font-semibold text-[#1a1c1c]">@Model.Price.ToString("C")</span>
                </div>
                @if (Model.Capacity.HasValue)
                {
                    <div class="flex items-center gap-2 bg-[#f4f3f2] px-4 py-2 rounded-full">
                        <span class="material-symbols-outlined text-[#775a19] text-lg">groups</span>
                        <span class="text-sm font-semibold text-[#1a1c1c]">@Model.Capacity guests</span>
                    </div>
                }
            </div>

            <!-- Description -->
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="border-t border-[#e3e2e1] pt-6">
                    <p class="text-xs font-semibold text-[#4e4639] uppercase tracking-widest mb-2">Description</p>
                    <p class="text-sm text-[#1a1c1c]/80 leading-relaxed">@Model.Description</p>
                </div>
            }
        </div>
    </div>

    <!-- Action Bar -->
    <div class="flex items-center gap-4 mt-6">
        <a asp-action="Edit" asp-route-id="@Model.Id"
           class="inline-flex items-center gap-2 bg-[#775a19] hover:bg-[#5d4201] text-white text-sm font-semibold px-5 py-2.5 rounded-full transition-all duration-300 shadow-md hover:shadow-lg">
            <span class="material-symbols-outlined text-base">edit</span> Edit Service
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id"
           class="inline-flex items-center gap-2 border border-red-300 text-red-600 hover:bg-red-50 text-sm font-semibold px-5 py-2.5 rounded-full transition-all duration-300">
            <span class="material-symbols-outlined text-base">delete</span> Delete
        </a>
    </div>
</div>
