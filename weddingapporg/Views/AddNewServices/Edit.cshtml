@model weddingapporg.Models.Service
@{
    ViewData["Title"] = "Edit Service";
}

<div class="max-w-3xl mx-auto px-6 py-10">

    <!-- Header -->
    <div class="mb-8">
        <a asp-action="Index" class="inline-flex items-center gap-1 text-sm text-[#775a19] hover:underline mb-4">
            <span class="material-symbols-outlined text-base">arrow_back</span> Back to Services
        </a>
        <h1 class="text-3xl font-headline font-bold text-[#1a1c1c] tracking-tight">Edit Service</h1>
        <p class="text-sm text-[#4e4639] mt-1 opacity-70">Update the details of this service</p>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-[#e3e2e1] p-8">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="mb-6 p-4 bg-red-50 border border-red-200 text-red-700 rounded-xl text-sm"></div>

            <input type="hidden" asp-for="Id" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <!-- Service Name -->
                <div class="md:col-span-2">
                    <label asp-for="Service_Name" class="block text-xs font-semibold text-[#4e4639] uppercase tracking-widest mb-2"></label>
                    <input asp-for="Service_Name" class="w-full border border-[#d1c5b4] rounded-xl px-4 py-3 text-sm text-[#1a1c1c] focus:outline-none focus:ring-2 focus:ring-[#775a19]/40 focus:border-[#775a19] transition-all" />
                    <span asp-validation-for="Service_Name" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Service Type -->
                <div>
                    <label asp-for="ServiceType" class="block text-xs font-semibold text-[#4e4639] uppercase tracking-widest mb-2"></label>
                    <select asp-for="ServiceType" class="w-full border border-[#d1c5b4] rounded-xl px-4 py-3 text-sm text-[#1a1c1c] focus:outline-none focus:ring-2 focus:ring-[#775a19]/40 focus:border-[#775a19] transition-all">
                        <option value="1">Venue</option>
                        <option value="2">Catering</option>
                        <option value="3">Photography</option>
                        <option value="4">Decoration</option>
                        <option value="5">Music & Entertainment</option>
                        <option value="6">Transportation</option>
                        <option value="7">Other</option>
                    </select>
                    <span asp-validation-for="ServiceType" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Price -->
                <div>
                    <label asp-for="Price" class="block text-xs font-semibold text-[#4e4639] uppercase tracking-widest mb-2"></label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[#4e4639]/60 text-sm">$</span>
                        <input asp-for="Price" type="number" step="0.01" min="0"
                               class="w-full border border-[#d1c5b4] rounded-xl pl-7 pr-4 py-3 text-sm text-[#1a1c1c] focus:outline-none focus:ring-2 focus:ring-[#775a19]/40 focus:border-[#775a19] transition-all" />
                    </div>
                    <span asp-validation-for="Price" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- City -->
                <div>
                    <label asp-for="City" class="block text-xs font-semibold text-[#4e4639] uppercase tracking-widest mb-2"></label>
                    <input asp-for="City" class="w-full border border-[#d1c5b4] rounded-xl px-4 py-3 text-sm text-[#1a1c1c] focus:outline-none focus:ring-2 focus:ring-[#775a19]/40 focus:border-[#775a19] transition-all" />
                    <span asp-validation-for="City" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Capacity -->
                <div>
                    <label asp-for="Capacity" class="block text-xs font-semibold text-[#4e4639] uppercase tracking-widest mb-2"></label>
                    <input asp-for="Capacity" type="number" min="1"
                           class="w-full border border-[#d1c5b4] rounded-xl px-4 py-3 text-sm text-[#1a1c1c] focus:outline-none focus:ring-2 focus:ring-[#775a19]/40 focus:border-[#775a19] transition-all" />
                    <span asp-validation-for="Capacity" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Address -->
                <div class="md:col-span-2">
                    <label asp-for="Address" class="block text-xs font-semibold text-[#4e4639] uppercase tracking-widest mb-2"></label>
                    <input asp-for="Address" class="w-full border border-[#d1c5b4] rounded-xl px-4 py-3 text-sm text-[#1a1c1c] focus:outline-none focus:ring-2 focus:ring-[#775a19]/40 focus:border-[#775a19] transition-all" />
                    <span asp-validation-for="Address" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Main Image URL -->
                <div class="md:col-span-2">
                    <label asp-for="MainImage" class="block text-xs font-semibold text-[#4e4639] uppercase tracking-widest mb-2"></label>
                    <input asp-for="MainImage" class="w-full border border-[#d1c5b4] rounded-xl px-4 py-3 text-sm text-[#1a1c1c] focus:outline-none focus:ring-2 focus:ring-[#775a19]/40 focus:border-[#775a19] transition-all" />
                    <span asp-validation-for="MainImage" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Description -->
                <div class="md:col-span-2">
                    <label asp-for="Description" class="block text-xs font-semibold text-[#4e4639] uppercase tracking-widest mb-2"></label>
                    <textarea asp-for="Description" rows="4"
                              class="w-full border border-[#d1c5b4] rounded-xl px-4 py-3 text-sm text-[#1a1c1c] focus:outline-none focus:ring-2 focus:ring-[#775a19]/40 focus:border-[#775a19] transition-all resize-y"></textarea>
                    <span asp-validation-for="Description" class="text-red-500 text-xs mt-1 block"></span>
                </div>

            </div>

            <!-- Actions -->
            <div class="flex items-center justify-end gap-4 mt-8 pt-6 border-t border-[#e3e2e1]">
                <a asp-action="Index"
                   class="px-6 py-2.5 text-sm font-semibold text-[#4e4639] hover:text-[#1a1c1c] border border-[#d1c5b4] rounded-full transition-all hover:border-[#4e4639]">
                    Cancel
                </a>
                <button type="submit"
                        class="px-6 py-2.5 text-sm font-semibold text-white bg-[#775a19] hover:bg-[#5d4201] rounded-full shadow-md hover:shadow-lg transition-all duration-300">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
