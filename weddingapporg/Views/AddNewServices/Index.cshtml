@model IEnumerable<weddingapporg.Models.Service>
@{
    ViewData["Title"] = "Manage Services";
}

<div class="max-w-7xl mx-auto px-6 py-10">

    <!-- Page Header -->
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-headline font-bold text-[#1a1c1c] tracking-tight">Wedding Services</h1>
            <p class="text-sm text-[#4e4639] mt-1 opacity-70">Manage all available services for your wedding platform</p>
        </div>
        <a asp-action="Create"
           class="inline-flex items-center gap-2 bg-[#775a19] hover:bg-[#5d4201] text-white text-sm font-semibold px-5 py-2.5 rounded-full transition-all duration-300 shadow-md hover:shadow-lg">
            <span class="material-symbols-outlined text-lg">add</span>
            Add New Service
        </a>
    </div>

    <!-- Table Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-[#e3e2e1] overflow-hidden">
        @if (!Model.Any())
        {
            <div class="flex flex-col items-center justify-center py-24 text-center text-[#4e4639]/60">
                <span class="material-symbols-outlined text-5xl mb-3 opacity-30">event_available</span>
                <p class="text-lg font-medium">No services found</p>
                <p class="text-sm mt-1">Start by adding your first wedding service.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-[#e3e2e1]">
                    <thead class="bg-[#f4f3f2]">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-[#4e4639] uppercase tracking-widest">Service Name</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-[#4e4639] uppercase tracking-widest">Type</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-[#4e4639] uppercase tracking-widest">City</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-[#4e4639] uppercase tracking-widest">Price</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-[#4e4639] uppercase tracking-widest">Capacity</th>
                            <th class="px-6 py-4 text-right text-xs font-semibold text-[#4e4639] uppercase tracking-widest">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#e3e2e1]">
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-[#faf9f8] transition-colors duration-150">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrEmpty(item.MainImage))
                                        {
                                            <img src="@item.MainImage" alt="@item.Service_Name"
                                                 class="w-10 h-10 rounded-lg object-cover border border-[#e3e2e1]" />
                                        }
                                        else
                                        {
                                            <div class="w-10 h-10 rounded-lg bg-[#ffdea5]/40 flex items-center justify-center">
                                                <span class="material-symbols-outlined text-[#775a19] text-lg">photo</span>
                                            </div>
                                        }
                                        <div>
                                            <p class="font-semibold text-[#1a1c1c] text-sm">@item.Service_Name</p>
                                            <p class="text-xs text-[#4e4639]/60 mt-0.5">@item.Address</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-block bg-[#ffdea5]/50 text-[#5d4201] text-xs font-semibold px-3 py-1 rounded-full">
                                        Type @item.ServiceType
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-sm text-[#1a1c1c]/80">@item.City</td>
                                <td class="px-6 py-4 text-sm font-semibold text-[#775a19]">@item.Price.ToString("C")</td>
                                <td class="px-6 py-4 text-sm text-[#1a1c1c]/80">@(item.Capacity.HasValue ? item.Capacity.ToString() : "—")</td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center justify-end gap-2">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="p-2 rounded-lg text-[#4e4639] hover:bg-[#f4f3f2] hover:text-[#775a19] transition-all duration-200"
                                           title="View Details">
                                            <span class="material-symbols-outlined text-base">visibility</span>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="p-2 rounded-lg text-[#4e4639] hover:bg-[#f4f3f2] hover:text-[#775a19] transition-all duration-200"
                                           title="Edit">
                                            <span class="material-symbols-outlined text-base">edit</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="p-2 rounded-lg text-[#4e4639] hover:bg-red-50 hover:text-red-600 transition-all duration-200"
                                           title="Delete">
                                            <span class="material-symbols-outlined text-base">delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
