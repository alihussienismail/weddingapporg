@using weddingapporg.Data
@using weddingapporg.Models
@model IEnumerable<weddingapporg.Models.Service>
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Manage Services";
    var user = await UserManager.GetUserAsync(User);
    var isAdmin = user != null && user.IsAdmin;
}

<div class="max-w-7xl mx-auto px-6 py-10">

    <!-- Page Header -->
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-headline font-bold text-[#1a1c1c] tracking-tight">Wedding Services</h1>
            <p class="text-sm text-[#4e4639] mt-1 opacity-70">Manage all available services for your wedding platform</p>
        </div>
        @if (isAdmin)
        {
            <a asp-action="Create"
                   class="inline-flex items-center gap-2 bg-[#775a19] hover:bg-[#5d4201] text-white text-sm font-semibold px-5 py-2.5 rounded-full transition-all duration-300 shadow-md hover:shadow-lg">
                <span class="material-symbols-outlined text-lg">add</span>
                Add New Service
            </a>
        }
    </div>

    <!-- ✅ Container الذي يلف شبكة البطاقات (حسب طلب مدير البحث) -->
    <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var item in Model)
            {
                <div class="bg-white rounded-2xl shadow-md hover:shadow-xl transition-shadow duration-300 border border-[#e3e2e1] overflow-hidden flex flex-col">

                    <!-- Card Image -->
                    <div class="h-48 w-full overflow-hidden bg-[#f4f3f2]">
                        @if (!string.IsNullOrEmpty(item.MainImage))
                        {
                            <img src="@item.MainImage" alt="@item.Service_Name" class="w-full h-full object-cover transition-transform duration-300 hover:scale-105" />
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center text-[#4e4639]/40">
                                <span class="material-symbols-outlined text-5xl">image_not_supported</span>
                            </div>
                        }
                    </div>

                    <!-- Card Body -->
                    <div class="p-5 flex flex-col flex-grow">
                        <h3 class="text-xl font-headline font-semibold text-[#1a1c1c] mb-1 line-clamp-1">@item.Service_Name</h3>
                        <p class="text-xs text-[#4e4639]/60 mb-3 flex items-center gap-1">
                            <span class="material-symbols-outlined text-sm">location_on</span> @item.City
                        </p>
                  
                  

                        <!-- Details Grid -->
                        <div class="grid grid-cols-2 gap-3 text-sm mb-4">
                            <div class="bg-[#faf9f8] p-2 rounded-lg text-center">
                                <span class="block text-[10px] font-label uppercase text-[#4e4639]/60">Type</span>
                                <span class="font-semibold text-[#1a1c1c]">Type @item.ServiceType</span>
                            </div>
                            <div class="bg-[#faf9f8] p-2 rounded-lg text-center">
                                <span class="block text-[10px] font-label uppercase text-[#4e4639]/60">Price</span>
                                <span class="font-semibold text-[#775a19]">@item.Price.ToString("C")</span>
                            </div>
                            @if (item.Capacity.HasValue)
                            {
                                <div class="bg-[#faf9f8] p-2 rounded-lg text-center col-span-2">
                                    <span class="block text-[10px] font-label uppercase text-[#4e4639]/60">Capacity</span>
                                     <span class="font-semibold text-[#1a1c1c]">@item.Capacity Guests</span>
                                </div>
                            }
                            else
                            {
                                <div class="bg-[#faf9f8] p-2 rounded-lg text-center col-span-2">
                                    <span class="block text-[10px] font-label uppercase text-[#4e4639]/60">Capacity</span>
                                    <span class="font-semibold text-[#1a1c1c]">—</span>
                                </div>
                            }
                        </div>

                        <!-- Address snippet -->
                        @if (!string.IsNullOrEmpty(item.Address))
                        {
                            <p class="text-xs text-[#4e4639]/60 mt-1 line-clamp-1 mb-3">
                                📍 @item.Address
                            </p>
                        }

                        <!-- Action Buttons -->
                        <div class="flex items-center justify-between gap-2 mt-auto pt-3 border-t border-[#e3e2e1]">
                            <a asp-action="Details" asp-route-id="@item.Id"
                                   class="inline-flex items-center gap-1 text-sm text-[#4e4639] hover:text-[#775a19] transition-colors">
                                <span class="material-symbols-outlined text-base">visibility</span>
                                View
                            </a>
                            @if (isAdmin)
                            {
                                <div class="flex items-center gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="inline-flex items-center gap-1 text-sm text-[#4e4639] hover:text-[#775a19] transition-colors">
                                        <span class="material-symbols-outlined text-base">edit</span>
                                        Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="inline-flex items-center gap-1 text-sm text-[#4e4639] hover:text-red-600 transition-colors"
                                           onclick="return confirm('Are you sure you want to delete this service?');">
                                        <span class="material-symbols-outlined text-base">delete</span>
                                        Delete
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .line-clamp-1 {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>