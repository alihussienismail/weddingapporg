@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>Login | The Editorial Wedding</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,700;1,400&amp;family=Manrope:wght@300;400;500;600&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "on-surface-variant": "#4e4639",
                        "primary-fixed": "#ffdea5",
                        "on-primary-fixed": "#261900",
                        "on-secondary-fixed": "#1b1c1c",
                        "on-error-container": "#93000a",
                        "surface-tint": "#775a19",
                        "primary": "#775a19",
                        "secondary-fixed": "#e4e2e1",
                        "tertiary-fixed-dim": "#c9c6c1",
                        "primary-container": "#c5a059",
                        "surface-container-low": "#f4f3f2",
                        "surface-dim": "#dadad9",
                        "tertiary-fixed": "#e5e2dc",
                        "error-container": "#ffdad6",
                        "surface-bright": "#faf9f8",
                        "on-error": "#ffffff",
                        "secondary-container": "#e4e2e1",
                        "primary-fixed-dim": "#e9c176",
                        "on-primary-fixed-variant": "#5d4201",
                        "on-secondary": "#ffffff",
                        "tertiary-container": "#a7a5a0",
                        "surface-container-high": "#e9e8e7",
                        "on-primary-container": "#4e3700",
                        "on-tertiary-container": "#3b3b37",
                        "on-secondary-container": "#656464",
                        "inverse-primary": "#e9c176",
                        "tertiary": "#5f5e5a",
                        "error": "#ba1a1a",
                        "on-surface": "#1a1c1c",
                        "surface-container": "#eeeeed",
                        "outline": "#7f7667",
                        "secondary": "#5f5e5e",
                        "on-tertiary-fixed": "#1c1c18",
                        "on-tertiary": "#ffffff",
                        "on-primary": "#ffffff",
                        "background": "#faf9f8",
                        "on-secondary-fixed-variant": "#474747",
                        "surface": "#faf9f8",
                        "surface-container-lowest": "#ffffff",
                        "inverse-surface": "#2f3130",
                        "inverse-on-surface": "#f1f0f0",
                        "on-background": "#1a1c1c",
                        "outline-variant": "#d1c5b4",
                        "on-tertiary-fixed-variant": "#474743",
                        "surface-container-highest": "#e3e2e1",
                        "secondary-fixed-dim": "#c8c6c5",
                        "surface-variant": "#e3e2e1"
                    },
                    fontFamily: {
                        "headline": ["Noto Serif"],
                        "body": ["Manrope"],
                        "label": ["Manrope"]
                    },
                    borderRadius: {"DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem"},
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        body {
            background-color: #faf9f8;
            color: #1a1c1c;
        }
    </style>
</head>
<body class="font-body antialiased">
<main class="relative min-h-screen flex overflow-hidden">
    <div class="hidden lg:flex lg:w-3/5 xl:w-2/3 relative">
        <div class="absolute inset-0 bg-on-surface/10 z-10"></div>
        <img alt="Elegant wedding ceremony" class="absolute inset-0 w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAmtcb7U2fEIECrjm_Eb-xGyaA8WILEEYCbcMTd1j65AC2EWCkkd3lCjqaW76O6GU_GNwT3vY0Cn0aFeTacZ1EOi9ywS32L_3LTv07HHsnfCo2danKRTsKgm9xrGEXqS357yzOT1VlfHSVszYK_0ZLZKzWy29WNhgUcKdwqd9gXoeOrdqODF4Dxsl7G9OL4t0mVDIbuYxSvQL5IOdSa5yG4XZsoxOUbHsrnlHZKCvAOi4eSQLSEE7HFLyjUPHIH2NYedJRKhRxssAo"/>
        <div class="absolute bottom-16 left-16 z-20 max-w-lg">
            <h2 class="font-headline text-5xl md:text-6xl text-surface italic leading-tight mb-6">Capturing the soul of your celebration.</h2>
            <div class="flex items-center gap-4">
                <div class="h-[1px] w-12 bg-primary-container"></div>
                <p class="font-label text-xs tracking-[0.2em] text-surface-container uppercase">The Editorial Wedding Experience</p>
            </div>
        </div>
    </div>
    
    <div class="w-full lg:w-2/5 xl:w-1/3 bg-surface flex flex-col px-8 md:px-16 py-12 justify-between z-30">
        <div class="mb-12">
            <a class="inline-block" asp-page="/Index">
                <span class="font-headline italic text-2xl tracking-tight text-on-surface">The Editorial Wedding</span>
            </a>
        </div>
        
        <div class="flex-grow flex flex-col justify-center max-w-md mx-auto w-full">
            <div class="mb-10">
                <h1 class="font-headline text-4xl text-on-surface mb-2 tracking-tight">Welcome Back</h1>
                <p class="text-on-surface-variant font-light text-sm">Please enter your details to access your wedding dashboard.</p>
            </div>
            
            <!-- ✅ النموذج المعدل ليعمل مع ASP.NET Core Identity ✅ -->
            <form id="account" method="post" class="space-y-6">
                <div asp-validation-summary="ModelOnly" class="text-danger text-sm mb-4" role="alert"></div>
                
                <div>
                    <label class="font-label text-[0.7rem] uppercase tracking-widest text-on-surface mb-2 block" for="Input_Email">Email Address</label>
                    <input asp-for="Input.Email" class="w-full bg-surface-container-lowest border-none outline outline-1 outline-outline-variant/20 focus:outline-primary focus:ring-4 focus:ring-primary/5 px-4 py-3 text-sm transition-all duration-300 rounded-sm" placeholder="e.g. julian@vogue.com" type="email"/>
                    <span asp-validation-for="Input.Email" class="text-danger text-xs"></span>
                </div>
                
                <div>
                    <div class="flex justify-between items-center mb-2">
                        <label class="font-label text-[0.7rem] uppercase tracking-widest text-on-surface block" for="Input_Password">Password</label>
                        <a asp-page="./ForgotPassword" class="text-[0.7rem] uppercase tracking-widest text-primary hover:text-primary-container transition-colors">Forgot Password?</a>
                    </div>
                    <div class="relative">
                        <input asp-for="Input.Password" class="w-full bg-surface-container-lowest border-none outline outline-1 outline-outline-variant/20 focus:outline-primary focus:ring-4 focus:ring-primary/5 px-4 py-3 text-sm transition-all duration-300 rounded-sm" placeholder="••••••••" type="password"/>
                        <button class="absolute right-4 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-on-surface transition-colors" type="button" onclick="togglePasswordVisibility(this)">
                            <span class="material-symbols-outlined text-lg">visibility</span>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger text-xs"></span>
                </div>
                
                <div class="flex items-center gap-3">
                    <input asp-for="Input.RememberMe" class="w-4 h-4 rounded-sm border-outline-variant/40 text-primary focus:ring-primary/20 bg-surface-container-lowest" id="remember" type="checkbox"/>
                    <label class="text-xs text-on-surface-variant font-medium" for="remember">Keep me signed in for 30 days</label>
                </div>
                
                <div class="pt-4">
                    <button id="login-submit" type="submit" class="w-full bg-gradient-to-r from-primary to-primary-container text-on-primary py-4 font-label text-[0.75rem] uppercase tracking-[0.15em] font-semibold rounded-sm shadow-[0_10px_30px_rgba(119,90,25,0.15)] hover:opacity-90 active:scale-[0.98] transition-all duration-300">
                        Sign In
                    </button>
                </div>
            </form>
            
           
        <footer class="mt-12 text-center">
            <p class="text-[0.7rem] text-on-surface-variant/70 uppercase tracking-widest leading-loose">
                New to the experience? 
                <a asp-page="./Register" class="text-primary font-bold hover:underline underline-offset-4 decoration-primary/30 transition-all">Request Access</a>
            </p>
            <div class="mt-8 pt-8 border-t border-outline-variant/10 flex flex-wrap justify-center gap-6">
                <a class="text-[0.6rem] uppercase tracking-widest text-on-surface-variant/50 hover:text-primary transition-colors" href="#">Privacy</a>
                <a class="text-[0.6rem] uppercase tracking-widest text-on-surface-variant/50 hover:text-primary transition-colors" href="#">Terms</a>
                <a class="text-[0.6rem] uppercase tracking-widest text-on-surface-variant/50 hover:text-primary transition-colors" href="#">Support</a>
            </div>
        </footer>
    </div>
</main>

<script>
    function togglePasswordVisibility(button) {
        const input = button.previousElementSibling;
        const icon = button.querySelector('.material-symbols-outlined');
        if (input.type === 'password') {
            input.type = 'text';
            icon.textContent = 'visibility_off';
        } else {
            input.type = 'password';
            icon.textContent = 'visibility';
        }
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
</body>
</html>
